# ==================== Docker Compose 基础配置 ====================
APP_ENV=development

# ==================== 数据库配置 ====================
POSTGRES_DB=projectdb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=dev-secret-key-for-learning-only

# ==================== 前端构建配置 ====================
VITE_API_BASE_URL=
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key

# ==================== 后端 API Keys ====================
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_DEFAULT_LLM_MODEL=
DASHSCOPE_SUMMARY_LLM_MODEL=
DASHSCOPE_PLAN_LLM_MODEL=
DASHSCOPE_SUBAGENT_LLM_MODEL=

# embedding模型设置
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024
# RAG相关设置
# 知识库路径默认为backend/app/core/langgraph/rag/knowledge_base
RAG_COLLECTION_NAME=travel_knowledge
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
# 是否强制重建知识库，默认false
RAG_FORCE_REBUILD=false

LANGFUSE_SECRET_KEY=your-LANGFUSE_SECRET_KEY
LANGFUSE_PUBLIC_KEY=your-LANGFUSE_PUBLIC_KEY
# 由于langfuse的docker容器和该项目独立，需要通过host.docker.internal访问主机的网络
LANGFUSE_BASE_URL=http://host.docker.internal:3000

QWEATHER_API_KEY=your-api-key
QWEATHER_API_HOST=your-api-host

AMAP_API_KEY=your-AMAP_API_KEY

# ==================== CORS 配置 ====================
ALLOWED_ORIGINS=http://host.docker.internal:3000,http://localhost:7999,http://localhost:3001

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_DIR=../projectlogs